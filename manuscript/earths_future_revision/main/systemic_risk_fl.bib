@article{cummins_systemic_2014,
  title = {Systemic {{Risk}} and {{The U}}.{{S}}. {{Insurance Sector}}},
  author = {Cummins, J. David and Weiss, Mary A.},
  year = 2014,
  journal = {Journal of Risk and Insurance},
  volume = {81},
