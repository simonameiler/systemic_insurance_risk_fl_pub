@unpublished{boomhower_how_2024,
  type = {Working {{Paper}}},
  title = {How {{Are Insurance Markets Adapting}} to {{Climate Change}}? {{Risk Classification}} and {{Pricing}} in the {{Market}} for {{Homeowners Insurance}}},
  shorttitle = {How {{Are Insurance Markets Adapting}} to {{Climate Change}}?},
  author = {Boomhower, Judson and Fowlie, Meredith and Gellman, Jacob and Plantinga, Andrew},
  year = 2024,
  month = jun,
  series = {Working {{Paper Series}}},
  number = {32625},
  eprint = {32625},
  publisher = {National Bureau of Economic Research},
  doi = {10.3386/w32625},
  urldate = {2025-02-12},
  abstract = {Property insurance is critical for reducing household exposure to severe weather risks and aiding in recovery when disaster strikes. As climate risks escalate, insurers are investing in more sophisticated methods to classify and price complex disaster risks. We use proprietary data on parcel-level wildfire risk, together with insurers' regulatory filings, to investigate how wildfire risk insurance is being priced and provided in a large market for homeowners insurance. We document striking variation in insurers' risk classification and pricing strategies. Firms that rely on coarser measures of wildfire risk are exposed to potentially severe adverse selection as a result of their information disadvantage relative to insurers with richer models. Consistent with this fact, firms relying on simpler pricing methods charge relatively high prices in high-risk market segments -- or choose not to serve these areas at all. A theoretical model of a market for natural hazard insurance that incorporates both asymmetric risk classification and market regulation helps rationalize the empirical patterns we document. Our results highlight how the winner's curse can increase prices and limit participation in insurance markets for large, hard-to-model risks.},
  archiveprefix = {National Bureau of Economic Research},
  file = {/Users/simonameiler/Zotero/storage/PKNEJJXI/Boomhower et al. - 2024 - How Are Insurance Markets Adapting to Climate Chan.pdf}
}

@article{burby_hurricane_2006,
  title = {Hurricane {{Katrina}} and the {{Paradoxes}} of {{Government Disaster Policy}}: {{Bringing About Wise Governmental Decisions}} for {{Hazardous Areas}}},
  shorttitle = {Hurricane {{Katrina}} and the {{Paradoxes}} of {{Government Disaster Policy}}},
