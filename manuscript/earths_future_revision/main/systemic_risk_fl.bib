@article{liu_recalibrating_2026,
  title = {Recalibrating {{Risk}}: A Simplified Model for {{North Atlantic}} Hurricanes in a Warming Climate},
  shorttitle = {Recalibrating {{Risk}}},
  author = {Liu, Juner and Steinmann, Carmen B. and Bresch, David N. and Meiler, Simona and Lohmann, Ulrike and Hohermuth, Benjamin},
  year = 2026,
  month = jun,
  journal = {Journal of Catastrophe Risk and Resilience},
  volume = {04},
  number = {03},
  issn = {3049-7604},
  doi = {10.63024/zd46-e3zf},
  urldate = {2026-06-05},
  abstract = {North Atlantic hurricanes rank among the costliest natural hazards. Their impacts have increased over recent decades and are projected to rise further with climate change. Yet catastrophe models used in (re)insurance remain largely static, reflecting historical climate with limited integration of near-term climate signals. We present a simplified tropical cyclone model to estimate climate-connected landfall rate changes for North Atlantic hurricanes. Using reanalysis and climate model data, we quantify hazard changes for near-present (+1.2{$^\circ$}C) and future (+2{$^\circ$}C) climates relative to the historical baseline (1980--2025). These changes are used to adjust a year event loss table with a static view of risk by resampling. We find the average annual loss increases by 15\% in the near-present (+1.2{$^\circ$}C) climate, and the 1-in-10-year loss increases by 11\%. Results show substantially higher landfall and loss increases under future (+2{$^\circ$}C) climate than previous studies, highlighting the critical but often overlooked role of frequency changes in hurricane risk assessment.},
  copyright = {https://creativecommons.org/licenses/by/4.0/deed.en},
  file = {/Users/simonameiler/Zotero/storage/8Z945QWM/Liu et al. - 2026 - Recalibrating Risk a simplified model for North Atlantic hurricanes in a warming climate.pdf}
}

