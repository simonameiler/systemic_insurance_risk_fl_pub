}

@article{kousky_role_2019,
  title = {The {{Role}} of {{Natural Disaster Insurance}} in {{Recovery}} and {{Risk Reduction}}},
  author = {Kousky, Carolyn},
  year = 2019,
  month = oct,
  journal = {Annual Review of Resource Economics},
  volume = {11},
